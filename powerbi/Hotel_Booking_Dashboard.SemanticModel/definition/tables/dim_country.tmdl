table dim_country
	lineageTag: 475b1dff-fafe-4dc0-afb9-c7d294ca23b4

	column country
		dataType: string
		lineageTag: 0fc91a62-49e0-496b-a8b0-53a18d26e078
		summarizeBy: none
		sourceColumn: country

	column bookings
		dataType: int64
		lineageTag: 74cda32c-5103-4f50-8790-3ad01bb85088
		summarizeBy: none
		sourceColumn: bookings

	column country_name
		dataType: string
		lineageTag: c83e4aea-f2d0-49ac-912f-2ad1352fa4e0
		summarizeBy: none
		sourceColumn: country_name

	column is_domestic
		dataType: int64
		lineageTag: 6dbc4c76-61e7-40f5-a743-6c8bf9e0dc97
		summarizeBy: none
		sourceColumn: is_domestic

	partition dim_country = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_country.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"country", type text}, {"bookings", Int64.Type}, {"country_name", type text}, {"is_domestic", Int64.Type}}, "en-US")
				in
				    Typed

