table forecast_weekly
	lineageTag: fba06f19-3276-4f98-b99f-f9129808f53c

	column week_start
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: b04b8084-3d53-4c40-9bed-1f36d3d96619
		summarizeBy: none
		sourceColumn: week_start

		annotation UnderlyingDateTimeDataType = Date

	column actual
		dataType: int64
		lineageTag: 6400640f-e07c-476d-aca8-3344fe29e1b8
		summarizeBy: none
		sourceColumn: actual

	column is_test
		dataType: int64
		lineageTag: 623d0dc3-6f82-44ed-a703-6ffe87f90d0b
		summarizeBy: none
		sourceColumn: is_test

	column forecast_seasonal_naive
		dataType: int64
		lineageTag: 2c077f7b-0b9d-4fd2-a785-9804b64bd2ea
		summarizeBy: none
		sourceColumn: forecast_seasonal_naive

	column forecast_naive_growth
		dataType: double
		lineageTag: 17a8ac49-4103-47c3-8ffd-77b718356f18
		summarizeBy: none
		sourceColumn: forecast_naive_growth

	column forecast_fourier
		dataType: double
		lineageTag: 824e2ec8-69c6-42dd-b82b-342ff5502387
		summarizeBy: none
		sourceColumn: forecast_fourier

	column fitted_fourier
		dataType: double
		lineageTag: 4bf4564e-f9ee-4b63-88d6-c28568a31345
		summarizeBy: none
		sourceColumn: fitted_fourier

	partition forecast_weekly = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "forecast_weekly.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"week_start", type date}, {"actual", Int64.Type}, {"is_test", Int64.Type}, {"forecast_seasonal_naive", Int64.Type}, {"forecast_naive_growth", type number}, {"forecast_fourier", type number}, {"fitted_fourier", type number}}, "en-US")
				in
				    Typed

